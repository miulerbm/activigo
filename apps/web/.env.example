# Supabase Postgres connection string
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"

# Secret used to sign admin JWTs
JWT_SECRET="change-me"

# Password compared against POST /api/auth/login
ADMIN_PASSWORD="change-me"

# Public URL of this app (used to resolve absolute URLs for the Open Graph
# image and for server-side fetches to this app's own API routes)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Supabase project URL and service role key (Settings -> API), used server-side
# to upload images to the "activity-images" storage bucket
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="change-me"
