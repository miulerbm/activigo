generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Activity {
  id             String         @id @default(cuid())
  title          String
  description    String?
  status         ActivityStatus @default(PUEDE_SER)
  tags           ActivityTag[]
  location       String?
  imageUrl       String?
  featured       Boolean        @default(false)
  date           DateTime?
  signupDeadline DateTime?
  maxCapacity    Int?
  createdAt      DateTime       @default(now())
  signups        Signup[]
}

enum ActivityStatus {
  PUEDE_SER
  NIKA_Y_SI_SI
  GO_DE_UNA
  CANCELADO
}

enum ActivityTag {
  AL_AIRE_LIBRE
  FITNESS
  EN_LA_CIUDAD
  FUERA_DE_LA_CIUDAD
}

model Signup {
  id         String   @id @default(cuid())
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name       String
  createdAt  DateTime @default(now())

  @@index([activityId])
}

model Suggestion {
  id          String           @id @default(cuid())
  name        String
  description String
  imageUrl    String?
  status      SuggestionStatus @default(PENDIENTE)
  createdAt   DateTime         @default(now())
}

enum SuggestionStatus {
  PENDIENTE
  APROBADA
  DESCARTADA
}
