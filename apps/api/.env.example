# Supabase Postgres connection string (fill in later)
DATABASE_URL="postgresql://user:password@host:5432/postgres?schema=public"

# Secret used to sign admin JWTs
JWT_SECRET="change-me"

# Password compared against POST /auth/login
ADMIN_PASSWORD="change-me"

# Port the Nest server listens on (optional, defaults to 3001)
PORT=3001

# URL of the deployed apps/web, used to restrict CORS (leave unset locally to allow any origin)
WEB_URL="https://your-app.vercel.app"
